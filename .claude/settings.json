{
  "_squadai_permissions": "managed",
  "agent": "orchestrator",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "command": "squadai budget-hook --event Stop",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "squadai budget-hook --event UserPromptSubmit",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git rebase*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo rm*)",
      "Bash(dd if=*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(**/secrets/**)",
      "Read(**/.aws/credentials)",
      "Read(**/.ssh/id_*)"
    ]
  }
}
